rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /opsActivities/{activityId} { allow read, create, update, delete: if true; }
    match /opsCountdown/{countdownId} { allow read, create, update, delete: if true; }
    match /opsMtdSnapshot/{snapshotId} { allow read, create, update, delete: if true; }
    match /opsAgents/{agentId} { allow read, create, update, delete: if true; }
    match /opsEdits/{editId} { allow read, create: if true; allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
